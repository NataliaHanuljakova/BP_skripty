# Zakladna konfiguracia pipeline (upravte podla lokalneho prostredia)

# Vstupne FASTQ data (raw)
RAW_FASTQ_DIR="path/to/all_raw"

# Referencny genom (FASTA)
REF_FASTA="path/to/GRCh38.fa"

# BED subor primerov
PRIMER_BED="path/to/primers.bed"

# BED subor cielovych oblasti
PANEL_BED="path/to/ampliconInsert.bed"

# Cesta k tabulke vzoriek
TSV_FILE="config/samples.tsv"

# Panel normalnych vzoriek
PON="path/to/pon.vcf.gz"

# Populacny zdroj zarodocnych variantov
GNOMAD="path/to/af-only-gnomad.hg38.vcf.gz"

# Vystupy
RESULTS_DIR="results"
LOG_DIR="logs"

# Subory pre anotaciu 
VEP_SIF="path/to/vep.sif"
VEP_CACHE="path/to/.vep"

# Multi-threading
THREADS_QC=4
THREADS_FASTP=4
THREADS_MAP=8
THREADS_TRIM=4
THREADS_MAP=1
THREADS_MUTECT=4
THREADS_VEP=4
